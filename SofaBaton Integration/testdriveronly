/*
    Sofabaton MQTT Minimal Test Driver
    Isolates Hubitat interfaces.mqtt delivery from the Sofabaton Integration.
    Connect, subscribe, publish, and log everything that arrives in parse().

    2026-09-22: checkBuiltInBroker added (MQTTHelper shipped).
    2026-09-29: publishTest added so tests can run from the Hubitat UI
                (remote access) without MQTT Explorer. Topic accepts wildcards.
*/

import hubitat.helper.MQTTHelper

metadata {
    definition (name: "Sofabaton MQTT Minimal Test", namespace: "jdthomas24", author: "jdthomas24") {
        capability "Actuator"
        attribute "mqttStatus", "string"
        attribute "lastMessage", "string"
        attribute "brokerRunning", "string"
        command "connectMqtt"
        command "disconnectMqtt"
        command "checkBuiltInBroker"
        command "publishTest", [[name: "topic", type: "STRING"], [name: "payload", type: "STRING"]]
    }
    preferences {
        input name: "mqttHost", type: "text", title: "Broker Host/IP", defaultValue: "192.168.1.129"
        input name: "mqttPort", type: "text", title: "Broker Port", defaultValue: "1883"
        input name: "mqttUser", type: "text", title: "Broker Username", defaultValue: "hubitat"
        input name: "mqttPass", type: "password", title: "Broker Password"
        input name: "testTopic", type: "text", title: "Topic to subscribe to (wildcards # and + allowed)", defaultValue: "test/hello"
        input name: "logEnable", type: "bool", title: "Enable debug logging", defaultValue: true
    }
}

void installed() { log.info "Sofabaton MQTT Minimal Test installed" }

void updated() { log.info "Sofabaton MQTT Minimal Test updated (Disconnect then Connect to apply topic changes)" }

void connectMqtt() {
    String url = "tcp://${mqttHost}:${mqttPort}"
    log.info "Sofabaton MQTT Minimal Test: connecting to $url, will subscribe to '${testTopic}'"
    try {
        interfaces.mqtt.connect(url, "sofabaton-minimal-test-${device.id}", mqttUser ?: null, mqttPass ?: null)
    } catch (e) {
        log.error "Sofabaton MQTT Minimal Test: connect failed: ${e.message}"
        sendEvent(name: "mqttStatus", value: "connect failed")
    }
}

void disconnectMqtt() {
    try { interfaces.mqtt.disconnect() } catch (e) { }
    sendEvent(name: "mqttStatus", value: "disconnected")
    log.info "Sofabaton MQTT Minimal Test: disconnected"
}

void checkBuiltInBroker() {
    try {
        boolean running = MQTTHelper.isBuiltInBrokerRunning()
        log.info "Sofabaton MQTT Minimal Test: isBuiltInBrokerRunning() = $running"
        sendEvent(name: "brokerRunning", value: running.toString())
    } catch (e) {
        log.error "Sofabaton MQTT Minimal Test: isBuiltInBrokerRunning() failed: ${e.message}"
        sendEvent(name: "brokerRunning", value: "error")
    }
}

// Publishes from this client. If the topic matches testTopic, the message should loop back to parse().
void publishTest(String topic, String payload) {
    if (!topic) { log.warn "Sofabaton MQTT Minimal Test: publishTest needs a topic"; return }
    try {
        interfaces.mqtt.publish(topic, payload ?: "")
        log.info "Sofabaton MQTT Minimal Test: published to '${topic}': ${payload}"
    } catch (e) {
        log.error "Sofabaton MQTT Minimal Test: publish failed: ${e.message}"
    }
}

void mqttClientStatus(String message) {
    log.info "Sofabaton MQTT Minimal Test: mqttClientStatus: $message"
    if (message.startsWith("Error")) {
        sendEvent(name: "mqttStatus", value: "error")
        return
    }
    if (message.contains("Connection succeeded")) {
        sendEvent(name: "mqttStatus", value: "connected")
        try {
            interfaces.mqtt.subscribe(testTopic)
            log.info "Sofabaton MQTT Minimal Test: subscribed to '${testTopic}'"
        } catch (e) {
            log.error "Sofabaton MQTT Minimal Test: subscribe failed: ${e.message}"
        }
    }
}

// Logs everything with no filtering. Nothing here means the problem is upstream in interfaces.mqtt.
void parse(String description) {
    log.warn "Sofabaton MQTT Minimal Test: *** MESSAGE RECEIVED *** raw: $description"
    try {
        def msg = interfaces.mqtt.parseMessage(description)
        log.warn "Sofabaton MQTT Minimal Test: topic=${msg.topic}, payload=${msg.payload}"
        sendEvent(name: "lastMessage", value: "${msg.topic} = ${msg.payload}")
    } catch (e) {
        log.error "Sofabaton MQTT Minimal Test: parse failed: ${e.message}"
    }
}
